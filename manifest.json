{
  "manifest_version": 3,
  "name": "GeoLink",
  "version": "1.1.1",
  "description": "Leva coordenadas do Google Maps ao topographic-map.com e gera a visada (perfil de elevação e Fresnel) entre 2 pontos medidos.",
  "permissions": [
    "clipboardRead",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.solwise.co.uk/*",
    "https://api.opentopodata.org/*",
    "https://api.open-meteo.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["visada.html", "visada.js", "icon32.png"],
      "matches": ["https://*.google.com/*", "https://*.google.com.br/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GeoLink",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
